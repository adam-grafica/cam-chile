# ───────────────────────────────────────────────────────────────────
# CAM-CHILE — Variables de entorno (plantilla)
# Copiar a .env y completar. Nunca commitear .env real.
# ───────────────────────────────────────────────────────────────────

# Entorno
ENV=development                # development | production

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# CORS — lista separada por comas. NUNCA usar "*" con allow_credentials=true.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# Allowlist de hosts permitidos para URLs externas (cámaras, streams)
ALLOWED_HOSTS=youtube.com,youtu.be,youtube-nocookie.com,webcams.travel,skylinewebcams.com

# SSRF — bloquear rangos privados. Por defecto true.
BLOCK_PRIVATE_NETWORKS=true

# YouTube — opcional. Si está vacío, solo se usa oEmbed (sin auth).
YOUTUBE_API_KEY=

# Logging
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | text

# Rate limit (token bucket) por IP
RATE_LIMIT_PER_MINUTE=60