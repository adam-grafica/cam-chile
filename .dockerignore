dist/
build/
*.whl
node_modules/

# IDE y testing
.vscode/
.idea/
.coverage
htmlcov/
coverage.xml
.pytest_cache/
*.log

# Documentación (no es parte de la imagen)
docs/

# Worktrees y archivos auxiliares
.worktrees/
.tools/

