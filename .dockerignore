# Excluir del contexto de Docker build
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# No incluir secretos ni configuración local.
.env
.env.*
!.env.example

# DB local y caches
backend/db/*.db
backend/db/*.sqlite
catalog/.cache/

